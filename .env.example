# Configurações do PostgreSQL
POSTGRES_PASSWORD=
POSTGRES_USER=postgres
POSTGRES_DB=postgres

# Configurações do RabbitMQ — usuário próprio, não o "guest" padrão: o guest só
# aceita conexão vinda de localhost, e os serviços conectam pelo hostname
# "rabbitmq" na rede interna do docker-compose.
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# Configurações de SMTP do MS Email (Semana 01 do cronograma: Gmail do time +
# senha de app — nunca a senha real neste arquivo, só em .env local/produção).
# MAIL_USER é o endereço Gmail completo; MAIL_PASS é a senha de app de 16
# caracteres gerada em myaccount.google.com/apppasswords (não a senha da conta).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# Configurações do MongoDB (MS Auth) — usuário raiz próprio, mesma lógica do
# RabbitMQ: sem credencial, o mongo roda sem autenticação nenhuma na rede do
# docker-compose.
MONGO_USER=
MONGO_PASSWORD=

# Segredo usado pelo Gateway para assinar o JWT (Semana 03). Só o Gateway conhece isto;
# os microsserviços nunca verificam o JWT, confiam nos headers X-User-CPF/
# X-User-Tipo que o Gateway injeta. Gere algo aleatório de verdade, não uma
# frase — ex.: `openssl rand -hex 32`.
JWT_SECRET=
